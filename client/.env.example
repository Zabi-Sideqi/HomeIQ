# Client Environment Variables for Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Notes:
# 1. Get your publishable key from: https://dashboard.stripe.com/test/apikeys
# 2. Use test key (pk_test_...) for development
# 3. Switch to live key (pk_live_...) for production
# 4. This key is safe to expose in frontend as it's designed for client-side use
